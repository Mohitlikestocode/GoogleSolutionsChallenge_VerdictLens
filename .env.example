# GROQ_API_KEY: Optional for real LLM bias probing with Groq models.
# Set this for backend persona scoring against a live model.
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BACKEND_URL: Optional local or deployed FastAPI backend base URL.
# Example: http://localhost:8000
VITE_BACKEND_URL="http://localhost:8000"
